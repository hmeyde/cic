# Modèle de configuration du déploiement. Copier en .env (non versionné) et remplacer chaque A_CHANGER.
# Ce fichier ne contient et ne doit contenir aucun vrai secret.

# Permet de lancer simplement « docker compose up -d --build » avec la configuration de production.
COMPOSE_FILE=docker-compose.prod.yml

# demo : données de démonstration, codes clients fixes (000000), bouton de réinitialisation.
# prod : base réelle, sans données de démonstration.
SPRING_PROFILES_ACTIVE=demo

# Nom de domaine public (certificat Let's Encrypt) ; localhost pour un essai local.
SEHELI_DOMAINE=localhost

DB_NAME=cic
DB_USERNAME=cic
DB_PASSWORD=A_CHANGER

# Comptes du back-office créés au premier démarrage (profils dev et demo).
SEHELI_BO_ADMIN_IDENTIFIANT=admin
SEHELI_BO_ADMIN_MOT_DE_PASSE=A_CHANGER
SEHELI_BO_ANALYSTE_IDENTIFIANT=analyste
SEHELI_BO_ANALYSTE_MOT_DE_PASSE=A_CHANGER
SEHELI_BO_RECOUVREMENT_IDENTIFIANT=recouvrement
SEHELI_BO_RECOUVREMENT_MOT_DE_PASSE=A_CHANGER
SEHELI_BO_ASSOCIE_IDENTIFIANT=associe
SEHELI_BO_ASSOCIE_MOT_DE_PASSE=A_CHANGER

# Sauvegarde quotidienne de la base (service « sauvegarde ») : heure UTC et nombre de jours conservés.
SAUVEGARDE_HEURE=02:00
SAUVEGARDE_RETENTION_JOURS=14
